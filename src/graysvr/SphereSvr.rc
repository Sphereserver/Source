LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(1252)		//multilingual

/////////////////////////////////////////////////////////////////////////////
//
// Version
//
#include "../common/grayver.h"

VS_VERSION_INFO		VERSIONINFO
FILEVERSION			SPHERE_VER_FILEVERSION
FILEOS				SPHERE_VER_FILEOS
FILETYPE			VFT_APP
FILESUBTYPE			VFT2_UNKNOWN
FILEFLAGS			SPHERE_VER_FILEFLAGS
FILEFLAGSMASK		VS_FFI_FILEFLAGSMASK
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "FileDescription",	"SphereServer"
			VALUE "FileVersion",		SPHERE_VER_STR_FULL
			VALUE "InternalName",		"SphereSvr"
			VALUE "LegalCopyright",		"Copyright (C) 1997-2026 SphereServer development team"
			VALUE "OriginalFilename",	"SphereSvr.exe"
			VALUE "ProductName",		"SphereServer"
			VALUE "ProductVersion",		SPHERE_VER_STR_FULL
		END
	END

	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200	//0x409 = LANG_ENGLISH/SUBLANG_ENGLISH_US, 1200 = Unicode
	END
END

/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.

IDI_SPHERESVR	ICON	"spheresvr.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_POPUP_TRAY MENU
BEGIN
	POPUP "Tray Menu"
	BEGIN
		MENUITEM "Resync Pause",	IDM_RESYNC_PAUSE
		MENUITEM SEPARATOR
		MENUITEM "Statistics",		IDM_SHOW_STATS
		MENUITEM "About",			IDM_SHOW_ABOUT
		MENUITEM SEPARATOR
		MENUITEM "Exit",			IDM_EXIT
	END
END

IDR_POPUP_CONSOLE MENU
BEGIN
	POPUP "Console Menu"
	BEGIN
		MENUITEM "Copy",			IDM_COPY
		MENUITEM SEPARATOR
		MENUITEM "Resync Pause",	IDM_RESYNC_PAUSE
		MENUITEM SEPARATOR
		MENUITEM "Statistics",		IDM_SHOW_STATS
		MENUITEM "About",			IDM_SHOW_ABOUT
	END
END

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_STATS DIALOGEX 0, 0, 390, 260
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "SphereServer Statistics"
FONT 10, "Consolas", 400, 0, 0x1
BEGIN
	LTEXT		"Threads", IDC_STATIC, 5, 3, 50, 8
	LISTBOX		IDC_STATS_STATISTICS, 5, 13, 380, 114, LBS_NOINTEGRALHEIGHT | WS_VSCROLL
	LTEXT		"Clients", IDC_STATIC, 5, 131, 50, 8
	LISTBOX		IDC_STATS_CLIENTS, 5, 141, 380, 114, LBS_NOINTEGRALHEIGHT | WS_VSCROLL
END

IDD_ABOUT DIALOGEX 0, 0, 330, 180
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About SphereServer"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
	LTEXT		"", IDC_ABOUT_VERSION, 10, 3, 200, 8
	LTEXT		"", IDC_ABOUT_COMPILER, 10, 11, 200, 8
	LTEXT		"Copyright (C) 1997-2026 SphereServer development team", IDC_STATIC, 10, 19, 200, 8
	CONTROL		"", IDC_ABOUT_UPDATE, "SysLink", LWS_RIGHT, 220, 3, 100, 8
	CONTROL		"", IDC_ABOUT_WEBSITE, "SysLink", LWS_RIGHT, 220, 19, 100, 8
	CONTROL		"", IDC_STATIC, "Static", SS_ETCHEDHORZ, 10, 32, 311, 2
	LTEXT		"This software makes use of:", IDC_STATIC, 10, 37, 310, 8
	LTEXT		"libev (v4.33)\nCopyright (C) 2007-2020 Marc Alexander Lehmann\nLicensed under the BSD 2-Clause license", IDC_STATIC, 15, 48, 300, 24
	LTEXT		"MySQL C API (v8.0.46)\nCopyright (C) 2000-2026 Oracle and/or its affiliates\nLicensed under the GNU GPLv2 with Universal FOSS Exception", IDC_STATIC, 15, 75, 300, 24
	LTEXT		"SQLite (v3.53.3)\nReleased into the public domain", IDC_STATIC, 15, 102, 300, 16
	LTEXT		"Twofish (v1.0)\nCopyright (C) 1998 Bruce Schneier, Doug Whiting, John Kelsey, Chris Hall, David Wagner\nReleased into the public domain", IDC_STATIC, 15, 121, 300, 24
	LTEXT		"zlib (v1.3.2)\nCopyright (C) 1995-2026 Jean-loup Gailly, Mark Adler\nLicensed under the zlib license", IDC_STATIC, 15, 148, 300, 24
END

